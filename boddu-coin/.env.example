# Private key for deployment (NEVER commit the actual .env file)
PRIVATE_KEY=your_private_key_here

# Infura or Alchemy API keys
INFURA_API_KEY=your_infura_key
ALCHEMY_API_KEY=your_alchemy_key

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_key

# Initial token supply (in tokens, will be multiplied by 10^18)
INITIAL_SUPPLY=1000000

# Faucet drip amount (tokens per claim)
FAUCET_DRIP_AMOUNT=100

# Faucet cooldown (in seconds, 86400 = 24 hours)
FAUCET_COOLDOWN=86400
